#!/usr/bin/env bash
# Claude's pre-push gate (2026-11-22; cancel list 2026-11-23; cancel by
# content 2026-11-24).
# Source: claude/tools/pre-push.
# Install: cp claude/tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#          git config claude.triggerstate <path to state file outside the repo>
#          git config claude.cancelfile   <path to cancel list outside the repo>
#
# The push goes ahead only if a state file says the routine was read as
# "enabled" within the last MAX_AGE seconds. Anything else is a HOLD:
# missing file, unreadable file, empty file, another status, an old read.
# A missing answer is treated as "no".
#
# State file format, one line:  <status> <unix time of the read>
# I write that line by hand after reading the trigger. The hook can't
# read the trigger itself, so it checks my record of the read, not the
# routine. It gates `git push` in this clone only.
set -u
max_age="${CLAUDE_GATE_MAX_AGE:-120}"
state="$(git config --get claude.triggerstate || true)"
hold() { echo "HOLD (pre-push gate): $1" >&2; exit 1; }
[ -n "$state" ] || hold "no state file configured (git config claude.triggerstate)"
[ -f "$state" ] && [ -r "$state" ] || hold "state file missing or unreadable: $state"
status=""; ts=""
read -r status ts < "$state" || true
[ -n "$status" ] || hold "state file is empty"
[ "$status" = "enabled" ] || hold "routine status recorded as '$status', not 'enabled'"
case "$ts" in ''|*[!0-9]*) hold "no usable timestamp in state file" ;; esac
now="$(date +%s)"; age=$(( now - ts ))
[ "$age" -ge 0 ] || hold "state timestamp is in the future"
[ "$age" -le "$max_age" ] || hold "routine was read ${age}s ago (limit ${max_age}s)"
# Second meaning of "stop" (Rei, 2026-11-23): "don't send this item".
# A cancel file lists commit ids that must never be sent, one per line.
# If any commit in this push is listed, HOLD, however fresh the "enabled"
# read is. Reopening the route does not reauthorize a cancelled item.
cancel="$(git config --get claude.cancelfile || true)"
if [ -n "$cancel" ] && [ -s "$cancel" ]; then
  zero=0000000000000000000000000000000000000000
  while read -r lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    [ "$lsha" = "$zero" ] && continue
    if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
    for c in $(git rev-list "$range" 2>/dev/null); do
      if grep -q "^$c" "$cancel"; then
        hold "push contains cancelled commit ${c:0:7}; it needs the owner's decision, not a retry"
      fi
      # Cancel by content (Rei, 2026-11-24): a line "text:<words>" cancels
      # the item, not one copy of it. Any commit that adds a line
      # containing <words> is held, whatever its id.
      while IFS= read -r rule; do
        case "$rule" in text:?*) needle="${rule#text:}" ;; *) continue ;; esac
        if git show --format= --unified=0 "$c" | grep '^+' | grep -v '^+++' | grep -F -q -- "$needle"; then
          hold "commit ${c:0:7} adds cancelled content (\"$needle\"); it needs the owner's decision, not a retry"
        fi
      done < "$cancel"
    done
  done
fi
echo "PASS (pre-push gate): routine read as enabled ${age}s ago; no cancelled commits in this push" >&2
exit 0
